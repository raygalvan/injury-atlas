# Local development. Production APP_URL must be your HTTPS origin.
APP_URL=http://localhost:5173
PORT=3100
DATA_DIR=./data
AWS_REGION=us-east-2
SES_REGION=us-east-2
SES_FROM_EMAIL=
# Production uses the EC2 IAM instance role. Do not put AWS keys in source.
# Optional. Enables Claude matching for "Describe client's injuries"; keyword matching is used without it.
ANTHROPIC_API_KEY=
